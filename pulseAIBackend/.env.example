PROJECT_NAME="Pulse AI Backend"
VERSION="1.0.0"
DESCRIPTION="Backend pour l'application Pulse AI"

# Bases de données & Services
DATABASE_URL=postgresql+asyncpg://pulse:pulse_secret@postgres:5432/pulse_db
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
QDRANT_HOST=qdrant:6333

# Sécurité (Keycloak)
KEYCLOAK_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE
KEYCLOAK_ISSUER=http://keycloak:8080/realms/pulse-ai

# CORS — origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://ai.pulse.local

# API Externes
LLM_API_URL=http://localhost:8000/v1
HORILLA_API_URL=http://horilla-server/api
WAZUH_SYSLOG_HOST=wazuh-server
CALENDAR_PROVIDER=internal
CALENDAR_DEFAULT_MEETING_HOUR=10
CALENDAR_LOOKAHEAD_DAYS=14
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
GOOGLE_CALENDAR_IMPERSONATION_USER=
OFFBOARDING_CONNECTOR_PROVIDER=internal
OFFBOARDING_WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_CHAT=30
RATE_LIMIT_WINDOW=60

# Docker — Credentials des services
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
ACME_EMAIL=admin@pulse.local
